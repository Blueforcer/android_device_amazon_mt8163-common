on early-init
    # Loading kernel modules in background
    start insmod_sh

on init
    # Change dynamic_boost permission
    chown system system /sys/devices/platform/dynamic_boost/dynamic_boost
    chmod 0750 /sys/devices/platform/dynamic_boost/dynamic_boost

    # Silent ota
    chown system system /sys/class/leds/lcd-backlight/silent

    # Adjust minimum free memory space
    write /proc/sys/vm/min_free_kbytes 16384

    export DOWNLOAD_CACHE /cache

on boot
   chown system system /sys/devices/platform/amazon-gating/state
   chown system system /sys/devices/platform/amazon-gating/enable

   chown system system /sys/devices/platform/gpio-privacy/state
   chown system system /sys/devices/platform/gpio-privacy/enable

on early-fs
   write /sys/block/zram0/comp_algorithm zstd

on post-fs-data
    start amzn_drmprov
    start amzn_dha_hmac

    # Create directory for storing securely securetime data
    mkdir /data/securetime 0770 media mediadrm

    # Create directory for audio data
    mkdir /data/amzn_audio/ 0770 audio audio

    # Create directory for aipc
    mkdir /dev/aipc/ 2770 system aipc

    # AmazonLedBrightnessController
    chown system system /sys/class/pwm/pwmchip0/pwm0/duty_cycle

    # BT/FM/GPS usage
    chmod 0660 /dev/ttyMT2
    chown system system /dev/ttyMT2

    # GPS
    mkdir /data/gps_mnl 0771 gps system
    mkdir /data/misc/gps 0770 gps system
    chown gps system /data/mpe_mnl
    chown gps gps /sys/class/gpsdrv/gps/pwrctl
    chown gps gps /sys/class/gpsdrv/gps/suspend
    chown gps gps /sys/class/gpsdrv/gps/state
    chown gps gps /sys/class/gpsdrv/gps/pwrsave
    chown gps gps /sys/class/gpsdrv/gps/status

    # Create char device file for WMT, GPS, BT, FM, WIFI
    mknod /dev/wmtWifi c 153 0
    chmod 0660 /dev/wmtWifi
    chown system system /dev/wmtWifi

    chown shell system /proc/driver/wmt_aee
    chown shell system /proc/driver/wmt_dbg

    # Camera
    chmod 0660 /dev/GAF001AF
    chown system camera /dev/GAF001AF

    chmod 0660 /dev/DW9714AF
    chown system camera /dev/DW9714AF

    chmod 0660 /dev/AD5820AF
    chown system camera /dev/AD5820AF

    chmod 0660 /dev/BU64745GWZAF
    chown system camera /dev/BU64745GWZAF

    chmod 0660 /dev/FM50AF
    chown system camera /dev/FM50AF

    # SMB
    chown system system /proc/smb/ScreenComm
    chmod 0660 /proc/smb/ScreenComm

    # WiFi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wpa_supplicant 0770 wifi wifi
    chown wifi wifi /data/misc/wifi

    # Wait for insmod_sh to finish all modules
    wait_for_prop sys.all.modules.ready 1

    # BT relayer mode used VCOM
    chown bluetooth net_bt_stack /dev/ttyGS2
    chmod 0660 /dev/ttyGS2

    # Char device for BT 3.0 HS
    mknod /dev/ampc0 c 151 0
    chown bluetooth bluetooth /dev/ampc0
    chmod 0660 /dev/ampc0

    # Accept RA
    write /proc/sys/net/ipv6/conf/default/accept_ra_rt_info_max_plen 64

on property:sys.sysctl.ip_loc_res_ports=*
    write /proc/sys/net/ipv4/ip_local_reserved_ports ${sys.sysctl.ip_loc_res_ports}

service amzn_drmprov /system/bin/amzn_drmprov_check
	class main
	user root
	group system drmrpc
	oneshot
	disabled

service amzn_dha_hmac /system/bin/amzn_dha_hmac
	class main
	user root
	group system drmrpc
	oneshot
	disabled

on property:sys.boot_completed=1
    write /sys/kernel/mm/ksm/pages_to_scan 100
    write /sys/kernel/mm/ksm/run 1
    write /sys/kernel/mm/ksm/sleep_millisecs 250
    write /sys/kernel/mm/ksm/seeker_sleep_millisecs 50
    write /sys/kernel/mm/ksm/mode "always"

    swapon_all /fstab.mt8163
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/min_free_kbytes 3796
    write /proc/sys/vm/swappiness 100

service wmt_loader /vendor/bin/wmt_loader
    class core
    user root
    group root system
    oneshot

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/
    user system
    group system
    class core

# CABC
on property:sys.hwc.video_mode=1
    write /sys/devices/soc/soc:mtkfb@0/backlight_mode "mov"

on property:sys.hwc.video_mode=0
    write /sys/devices/soc/soc:mtkfb@0/backlight_mode "off"

service p2p_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf -N \
    -ip2p0 -Dnl80211 -c/data/misc/wifi/p2p_supplicant.conf -e/data/misc/wifi/entropy.bin \
    -I/system/etc/wifi/p2p_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
